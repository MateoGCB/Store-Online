// Data model for the store. Table and column names are snake_case in PostgreSQL.
// Extra CHECK constraints live in the initial migration SQL (Prisma cannot express them).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum Fulfillment {
  PICKUP
  DELIVERY
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

enum StockReason {
  INITIAL
  SALE
  ADMIN_ADJUSTMENT
  CANCEL_RESTOCK
  LATE_PAYMENT
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  cart      Cart?
  addresses Address[]
  orders    Order[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  products Product[]

  @@map("categories")
}

model Product {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String
  /// Lowercased, accent-free copy of name + description used for search.
  searchText  String    @map("search_text")
  priceCents  Int       @map("price_cents")
  /// Physical units available for sale.
  stock       Int
  /// Units held by orders waiting for payment. Available = stock - reserved.
  reserved    Int       @default(0)
  active      Boolean   @default(true)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  categoryId  String    @map("category_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  stockMovements StockMovement[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([categoryId])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  storageKey String   @unique @map("storage_key")
  position   Int
  alt        String   @default("")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

model StockMovement {
  id        String      @id @default(uuid()) @db.Uuid
  productId String      @map("product_id") @db.Uuid
  delta     Int
  reason    StockReason
  note      String?
  orderId   String?     @map("order_id") @db.Uuid
  actorId   String?     @map("actor_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@map("stock_movements")
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  fullName   String   @map("full_name")
  phone      String
  street     String
  number     String
  floorApt   String?  @map("floor_apt")
  city       String
  province   String
  postalCode String   @map("postal_code")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model StoreSettings {
  /// Single-row table: the id is always 1 (enforced by a CHECK constraint).
  id                Int      @id @default(1)
  storeName         String   @map("store_name")
  shippingCostCents Int      @map("shipping_cost_cents")
  pickupAddress     String   @map("pickup_address")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("store_settings")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  number         Int         @unique @default(autoincrement())
  userId         String      @map("user_id") @db.Uuid
  status         OrderStatus @default(PENDING_PAYMENT)
  fulfillment    Fulfillment
  subtotalCents  Int         @map("subtotal_cents")
  shippingCents  Int         @map("shipping_cents")
  totalCents     Int         @map("total_cents")
  // Copy of the shipping address at checkout time (not a relation on purpose).
  shipFullName   String?     @map("ship_full_name")
  shipPhone      String?     @map("ship_phone")
  shipStreet     String?     @map("ship_street")
  shipNumber     String?     @map("ship_number")
  shipFloorApt   String?     @map("ship_floor_apt")
  shipCity       String?     @map("ship_city")
  shipProvince   String?     @map("ship_province")
  shipPostalCode String?     @map("ship_postal_code")
  shipNotes      String?     @map("ship_notes")
  notes          String?
  expiresAt      DateTime    @map("expires_at") @db.Timestamptz(3)
  paidAt         DateTime?   @map("paid_at") @db.Timestamptz(3)
  cancelledAt    DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  cancelReason   String?     @map("cancel_reason")
  needsAttention Boolean     @default(false) @map("needs_attention")
  attentionNote  String?     @map("attention_note")
  idempotencyKey String?     @map("idempotency_key")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  payments       Payment[]
  stockMovements StockMovement[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([needsAttention])
  @@map("orders")
}

model OrderItem {
  id                     String  @id @default(uuid()) @db.Uuid
  orderId                String  @map("order_id") @db.Uuid
  productId              String? @map("product_id") @db.Uuid
  nameSnapshot           String  @map("name_snapshot")
  unitPriceCentsSnapshot Int     @map("unit_price_cents_snapshot")
  quantity               Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  provider          String
  preferenceId      String?       @map("preference_id")
  checkoutUrl       String?       @map("checkout_url")
  providerPaymentId String?       @unique @map("provider_payment_id")
  status            PaymentStatus @default(PENDING)
  amountCents       Int           @map("amount_cents")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model WebhookEvent {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  eventId    String   @map("event_id")
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@map("webhook_events")
}
