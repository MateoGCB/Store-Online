NODE_ENV=development
PORT=4000
# Must match the credentials in the root .env used by docker-compose.yml
DATABASE_URL=postgresql://store:change-me@localhost:5433/store
# Test database: its name MUST end in _test (tests abort otherwise)
DATABASE_URL_TEST=postgresql://store:change-me@localhost:5433/store_test
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Comma-separated list of allowed browser origins (never *)
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
RESERVATION_MINUTES=30
UPLOAD_DIR=uploads
# Number of trusted proxy hops in front of the API (false when there is none)
TRUST_PROXY=false
# Mercado Pago test credentials (optional in test; required to take real test payments)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Only used by `npm run db:seed` to create the admin user
ADMIN_EMAIL=
ADMIN_PASSWORD=
